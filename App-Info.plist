<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Browser account linking (0.19 device hosts): ASWebAuthenticationSession
	     receives the SimplyPrint OAuth callback and the 3DPrinterOS login
	     on this scheme (the desktop instead runs a localhost callback
	     server — OAuthJob; iOS replaces it with the registered scheme). -->
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>ie.duz.OrcaPad.callbacks</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>orcapad</string>
			</array>
		</dict>
	</array>
	<!-- Expose Documents in the Files app ("On My iPhone → OrcaPad") -->
	<key>UIFileSharingEnabled</key>
	<true/>
	<key>LSSupportsOpeningDocumentsInPlace</key>
	<true/>
	<!-- Open-in from Files / Mail (desktop "Open with"): the geometry and
	     project formats the engine reads. 3MF opens as a project; the rest
	     import as models. -->
	<key>CFBundleDocumentTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeName</key>
			<string>STL model</string>
			<key>CFBundleTypeRole</key>
			<string>Editor</string>
			<key>LSHandlerRank</key>
			<string>Alternate</string>
			<key>LSItemContentTypes</key>
			<array>
				<string>ie.duz.orcapad.stl</string>
			</array>
		</dict>
		<dict>
			<key>CFBundleTypeName</key>
			<string>OBJ model</string>
			<key>CFBundleTypeRole</key>
			<string>Editor</string>
			<key>LSHandlerRank</key>
			<string>Alternate</string>
			<key>LSItemContentTypes</key>
			<array>
				<string>ie.duz.orcapad.obj</string>
			</array>
		</dict>
		<dict>
			<key>CFBundleTypeName</key>
			<string>AMF model</string>
			<key>CFBundleTypeRole</key>
			<string>Editor</string>
			<key>LSHandlerRank</key>
			<string>Alternate</string>
			<key>LSItemContentTypes</key>
			<array>
				<string>ie.duz.orcapad.amf</string>
			</array>
		</dict>
		<dict>
			<key>CFBundleTypeName</key>
			<string>3MF project</string>
			<key>CFBundleTypeRole</key>
			<string>Editor</string>
			<key>LSHandlerRank</key>
			<string>Alternate</string>
			<key>LSItemContentTypes</key>
			<array>
				<string>ie.duz.orcapad.3mf</string>
			</array>
		</dict>
	</array>
	<key>UTImportedTypeDeclarations</key>
	<array>
		<dict>
			<key>UTTypeIdentifier</key>
			<string>ie.duz.orcapad.stl</string>
			<key>UTTypeDescription</key>
			<string>Stereolithography model</string>
			<key>UTTypeConformsTo</key>
			<array>
				<string>public.data</string>
			</array>
			<key>UTTypeTagSpecification</key>
			<dict>
				<key>public.filename-extension</key>
				<array>
					<string>stl</string>
				</array>
			</dict>
		</dict>
		<dict>
			<key>UTTypeIdentifier</key>
			<string>ie.duz.orcapad.obj</string>
			<key>UTTypeDescription</key>
			<string>Wavefront OBJ model</string>
			<key>UTTypeConformsTo</key>
			<array>
				<string>public.data</string>
			</array>
			<key>UTTypeTagSpecification</key>
			<dict>
				<key>public.filename-extension</key>
			<array>
					<string>obj</string>
				</array>
			</dict>
		</dict>
		<dict>
			<key>UTTypeIdentifier</key>
			<string>ie.duz.orcapad.amf</string>
			<key>UTTypeDescription</key>
			<string>Additive manufacturing model</string>
			<key>UTTypeConformsTo</key>
			<array>
				<string>public.data</string>
			</array>
			<key>UTTypeTagSpecification</key>
			<dict>
				<key>public.filename-extension</key>
			<array>
					<string>amf</string>
				</array>
			</dict>
		</dict>
		<dict>
			<key>UTTypeIdentifier</key>
			<string>ie.duz.orcapad.3mf</string>
			<key>UTTypeDescription</key>
			<string>3MF model / OrcaSlicer project</string>
			<key>UTTypeConformsTo</key>
			<array>
				<string>public.data</string>
				<string>com.pkware.zip-archive</string>
			</array>
			<key>UTTypeTagSpecification</key>
			<dict>
				<key>public.filename-extension</key>
			<array>
					<string>3mf</string>
			</array>
			</dict>
		</dict>
	</array>
	<!-- Printers on the LAN (Moonraker/Klipper, OctoPrint) speak plain HTTP.
	     iOS 17+ ATS blocks IP-address hosts unless listed: allow the private,
	     link-local and CGNAT/Tailscale ranges, unqualified and .local names
	     (NSAllowsLocalNetworking), and any printer page inside the Device
	     tab web view (desktop PrinterWebView loads whatever the user set). -->
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsLocalNetworking</key>
		<true/>
		<key>NSAllowsArbitraryLoadsInWebContent</key>
		<true/>
		<key>NSExceptionDomains</key>
		<dict>
			<key>10.0.0.0/8</key>
			<dict>
				<key>NSExceptionAllowsInsecureHTTPLoads</key>
				<true/>
			</dict>
			<key>172.16.0.0/12</key>
			<dict>
				<key>NSExceptionAllowsInsecureHTTPLoads</key>
				<true/>
			</dict>
			<key>192.168.0.0/16</key>
			<dict>
				<key>NSExceptionAllowsInsecureHTTPLoads</key>
				<true/>
			</dict>
			<key>169.254.0.0/16</key>
			<dict>
				<key>NSExceptionAllowsInsecureHTTPLoads</key>
				<true/>
			</dict>
			<key>100.64.0.0/10</key>
			<dict>
				<key>NSExceptionAllowsInsecureHTTPLoads</key>
				<true/>
			</dict>
		</dict>
	</dict>
	<key>NSLocalNetworkUsageDescription</key>
	<string>OrcaPad connects to 3D printers on your network to send G-code and show their web interface.</string>
	<!-- Bonjour discovery in the printer editor (cycle-0.16): iOS 14+
	     requires every browsed service type to be declared, in addition to
	     NSLocalNetworkUsageDescription above. _http._tcp is the fallback
	     when the printer-specific types stay silent. -->
	<key>NSBonjourServices</key>
	<array>
		<string>_octoprint._tcp</string>
		<string>_moonraker._tcp</string>
		<string>_http._tcp</string>
	</array>
	<!-- App Store Connect export compliance [USER 2026-10-13]: only
	     OS-provided encryption (HTTPS via URLSession/WebKit) and hashing,
	     which are exempt. Declaring it here skips the per-build prompt. -->
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<!-- AGPL compliance (COMPLIANCE.md W2): identifies the exact source of
	     this binary. CI overwrites this with "<release-tag>+<commit-sha>"
	     before archiving; local builds keep the default. -->
	<key>ORCAPAD_SOURCE_REF</key>
	<string>development build — source: github.com/iSteeb/OrcaPad</string>
</dict>
</plist>
